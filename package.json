{
  "name": "opencode-hermes-memory",
  "version": "0.2.0",
  "description": "Layered persistent memory plugin for OpenCode — ported from Hermes agent",
  "type": "module",
  "main": "hermes-memory.ts",
  "exports": {
    "./server": "./hermes-memory.ts"
  },
  "files": [
    "hermes-memory.ts",
    "hermes-memory-lib"
  ],
  "scripts": {
    "test": "bun run hermes-memory-lib/tests/regression.ts",
    "typecheck": "tsc --noEmit",
    "lint": "biome check hermes-memory.ts hermes-memory-lib/",
    "lint:fix": "biome check --write hermes-memory.ts hermes-memory-lib/"
  },
  "keywords": [
    "opencode",
    "plugin",
    "memory",
    "hermes",
    "persistent-memory",
    "ai-agent",
    "llm"
  ],
  "license": "MIT",
  "author": {
    "name": "realchendahuang",
    "url": "https://github.com/realchendahuang"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/realchendahuang/opencode-hermes-memory.git"
  },
  "bugs": {
    "url": "https://github.com/realchendahuang/opencode-hermes-memory/issues"
  },
  "homepage": "https://github.com/realchendahuang/opencode-hermes-memory#readme",
  "engines": {
    "bun": ">=1.0.0",
    "opencode": ">=1.18.0"
  },
  "peerDependencies": {
    "@opencode-ai/plugin": "^1.18.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.8",
    "@opencode-ai/plugin": "^1.18.12",
    "@types/bun": "^1.1.0",
    "typescript": "^7.0.2"
  }
}
